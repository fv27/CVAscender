# CVAscender keys: TEMPLATE (no keys). Your real file is keys.env in the same folder.
# Fill in only what you have; EVERYTHING is optional.
# Without keys the site works fine (rule-based matching, no Sign in).
#
# This file stays on your computer. `npm run deploy` uploads the filled-in
# lines to Cloudflare as encrypted secrets; they are never put in the code.
# NEVER paste these keys into a chat, email or screenshot.

# --- AI explanations (server-only). Fill in ONE ---------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# --- Accounts: Supabase (server-only) ------------------------------------
# Use the ANON / PUBLISHABLE key, never the service_role / secret key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Encryption of student data (AES-256-GCM) -----------------------------
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy somewhere safe: if you lose it, saved data can't be read.
DATA_ENCRYPTION_KEY=

# --- Bot protection: Cloudflare Turnstile ---------------------------------
# The SITE key is public (shown in the browser); the SECRET key is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Shared rate limiting: Upstash Redis (optional) -----------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Payments: Stripe (later). Secret key ONLY here, never in the code ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
